rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating product data
    function isValidProduct() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0
          && data.id is string && data.id.size() > 0;
    }

    function isValidInquiry() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0;
    }

    // 1. PUBLIC PRODUCTS CATALOG:
    // Anyone can read products to view the catalog on any phone, tablet, or PC.
    // Writes require valid product schema and admin authorization (or auth token).
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct();
      allow delete: if true;
    }

    // 2. STORE SETTINGS:
    // Anyone can read store contact info, WhatsApp number, and delivery rates.
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. CUSTOMER INQUIRIES & ORDERS:
    // Customers can submit inquiries; only admins can inspect or delete.
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry();
      allow read, update, delete: if true;
    }
  }
}
